/* Transparent text controls; borders and an offset lower edge create depth on hover. */
.menu-action {
    height: 76px;
    margin-top: 18px;
    margin-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
    background-image: none;
    background-color: rgba(255, 255, 255, 0);
    color: rgb(22, 57, 66);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    border-width: 2px;
    border-color: rgba(130, 205, 216, 0);
    border-radius: 10px;
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale, background-color, border-color, color;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
}
.menu-action-depth {
    position: absolute;
    left: -2px;
    right: -2px;
    top: 4px;
    bottom: -8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 4px;
    border-color: rgba(58, 136, 153, 0.45);
    border-radius: 10px;
    opacity: 0;
    scale: 0.92 0.8;
    transition-property: opacity, scale;
    transition-duration: 220ms;
    transition-timing-function: ease-out;
}
.menu-action:hover, .menu-action:focus {
    background-color: rgba(255, 255, 255, 0.65);
    border-color: rgba(143, 219, 230, 0.95);
    color: rgb(22, 57, 66);
    translate: 0 -8px;
    scale: 1.035 1.035;
}
.menu-action:hover .menu-action-depth, .menu-action:focus .menu-action-depth {
    opacity: 1;
    scale: 1 1;
}
.menu-action:active {
    translate: 0 -2px;
    scale: 1.01 1.01;
    transition-duration: 80ms;
}
.menu-view {
    margin: 24px;
    background-color: rgba(150, 160, 167, 0.40);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.55);
}
.menu-action-compact {
    height: 56px;
    min-height: 40px;
    flex-shrink: 0;
    margin-top: 8px;
    margin-bottom: 12px;
    font-size: 22px;
}
.menu-action:disabled {
    opacity: 0.45;
    translate: 0 0;
    scale: 1 1;
}
.menu-action:disabled .menu-action-depth {
    opacity: 0;
}
.scroll-reveal-managed {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 280ms;
    transition-timing-function: ease-out;
}
.scroll-reveal-managed.scroll-reveal-visible {
    opacity: 1;
}
/* Keep scroll controls usable while removing the default heavy track and arrows. */
.menu-scroll .unity-scroller--vertical {
    width: 8px;
    margin-left: 6px;
    background-color: rgba(255, 255, 255, 0);
}
.menu-scroll .unity-scroller--horizontal {
    height: 8px;
    background-color: rgba(255, 255, 255, 0);
}
.menu-scroll .unity-scroller .unity-repeat-button {
    display: none;
}
.menu-scroll .unity-scroller .unity-base-slider {
    flex-grow: 1;
    margin: 0;
}
.menu-scroll .unity-scroller #unity-tracker {
    background-color: rgba(70, 96, 108, 0.06);
    border-width: 0;
    border-radius: 4px;
}
.menu-scroll .unity-scroller #unity-dragger {
    background-image: none;
    background-color: rgba(60, 89, 102, 0.28);
    border-width: 0;
    border-radius: 4px;
    min-height: 28px;
    transition-property: background-color;
    transition-duration: 180ms;
}
.menu-scroll .unity-scroller #unity-dragger:hover,
.menu-scroll .unity-scroller #unity-dragger:active {
    background-color: rgba(44, 83, 99, 0.60);
}